# ==============================================================================
# MERIDIAN PLATFORM ENVIRONMENT CONFIGURATION BLUEPRINT (.env.local)
# ==============================================================================

# 1. Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project.supabase.co:5432/postgres

# 2. Cloudflare R2 Raw Payload Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=meridian-raw-payloads

# 3. Wave 1 & Wave 2 Ingestion Feed API Keys (Mock Fallbacks Active if Missing)
FRED_API_KEY=your_fred_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key
FINNHUB_API_KEY=your_finnhub_api_key
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key
KALSHI_API_KEY=your_kalshi_api_key
EIA_API_KEY=your_eia_api_key
OPENCORPORATES_API_KEY=your_opencorporates_api_key
POLYGON_API_KEY=your_polygon_api_key
COINGLASS_API_KEY=your_coinglass_api_key

# 4. Multi-Model The Council LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
